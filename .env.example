# کپی این فایل رو به نام .env.local بسازید و مقادیر واقعی رو جایگزین کنید
# فایل .env.local هرگز نباید آپلود یا با کسی به اشتراک گذاشته بشه

# ---- ایمیلی که فرم‌های سایت باید بهش ارسال بشن ----
NOTIFY_EMAIL=you@example.com

# ---- تنظیمات SMTP برای ارسال ایمیل ----
# جیمیل: باید یک App Password بسازید (نه رمز عبور معمولی): https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=you@example.com
SMTP_PASS=your-app-password-here

# ---- دسترسی پنل مدیریت ----
# برای ساخت یک secret امن از دستور زیر استفاده کنید:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_PASSWORD=Voltinaadminpass
ADMIN_SESSION_SECRET=Voltinaadminpass
